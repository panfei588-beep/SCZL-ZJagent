# =============================================
# 质量异常诊断系统 - 环境变量配置
# 复制此文件为 .env 并填入真实值
# =============================================

# DashScope API Key（必填）
# 获取地址: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# PostgreSQL 密码（可修改，需与 docker-compose.yml 保持一致）
POSTGRES_PASSWORD=postgres123
